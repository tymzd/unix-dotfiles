#!/usr/bin/env bash
#
# Archives (hides) local branches. The only thing it deletes is tmp/ branches.
#
# Usage: git cleanup [-n|--dry-run] [-y|--yes]   archive branches (asks first)
#        git cleanup [-n] <branch>...             archive exactly these branches
#        git cleanup list                         show archived branches
#        git cleanup restore <branch>...          bring archived branches back
#
# With no branch names, a branch is archived if any of these is true:
#   - its name isn't prefixed by feat/, fix/ or chore/
#   - its last activity was more than 2 months ago (see git-branch-activity)
#   - it has no commits by you (user.email) that aren't already in the main
#     branch (origin/<default>, falling back to local main/master). Commits
#     that were rebased or cherry-picked into main count as merged; squash
#     merges don't. A branch with no commits of its own also counts.
# Branches named tmp/... are deleted outright (git branch -D) instead of
# archived; their tip SHAs are printed so they can be recovered if needed.
# Never archived automatically: the current branch, main/master/the remote
# default branch, and branches checked out in another worktree. Named
# branches can be anything except a checked-out one.
#
# Archiving moves refs/heads/<branch> to refs/archive/<branch>. The commits stay
# reachable (so gc never removes them), but the branch disappears from
# `git branch`, `git lg --all`, tab completion etc. Restoring moves it back.

set -euo pipefail

ARCHIVE=refs/archive
BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'

case "${1:-}" in
list)
    git for-each-ref --sort=-committerdate \
        --format="%(refname:strip=2)${DIM}  %(committerdate:short)  %(objectname:short)  %(contents:subject)${RESET}" \
        "$ARCHIVE"
    exit
    ;;
restore)
    shift
    [ $# -gt 0 ] || { echo "usage: git cleanup restore <branch>..." >&2; exit 1; }
    for b in "$@"; do
        sha=$(git rev-parse -q --verify "$ARCHIVE/$b") ||
            { echo "not archived: $b" >&2; exit 1; }
        if git show-ref -q --verify "refs/heads/$b"; then
            echo "branch already exists: $b (archived copy is at $ARCHIVE/$b)" >&2
            exit 1
        fi
        git update-ref -m "cleanup: restore" "refs/heads/$b" "$sha" ""
        git update-ref -d "$ARCHIVE/$b" "$sha"
        echo "restored $b"
    done
    exit
    ;;
esac

dry_run=0
yes=0
named=()
for a in "$@"; do
    case "$a" in
    -n | --dry-run) dry_run=1 ;;
    -y | --yes) yes=1 ;;
    -*) echo "unknown argument: $a" >&2; exit 1 ;;
    *) named+=("$a") ;;
    esac
done

current=$(git symbolic-ref -q --short HEAD || true)
remote_head=$(git symbolic-ref -q --short refs/remotes/origin/HEAD || true)
main_branch=${remote_head#*/}
cutoff=$(date -d '2 months ago' +%s)
me=$(git config user.email || true)

# What "merged" is measured against: the remote default branch if we know it,
# otherwise the usual names, remote first.
base=
for r in ${main_branch:+"refs/remotes/origin/$main_branch"} \
    refs/remotes/origin/main refs/remotes/origin/master refs/heads/main refs/heads/master; do
    if git rev-parse -q --verify "$r^{commit}" >/dev/null; then
        base=$r
        break
    fi
done

# Number of my commits on branch $1 that aren't in $base (by patch, so rebased
# or cherry-picked commits count as merged).
my_unmerged() {
    git rev-list --count --no-merges --right-only --cherry-pick \
        --fixed-strings --author="<$me>" "$base...refs/heads/$1" -- 2>/dev/null || echo 1
}

# Branches checked out in any worktree (including this one).
checked_out=$(git worktree list --porcelain | sed -n 's|^branch refs/heads/||p')

to_archive=()
reasons=()
to_delete=()

if [ ${#named[@]} -gt 0 ]; then
    # Explicitly named branches: archive exactly these, no prompt.
    for b in "${named[@]}"; do
        git show-ref -q --verify "refs/heads/$b" ||
            { echo "no such branch: $b" >&2; exit 1; }
        if grep -qxF -- "$b" <<<"$checked_out"; then
            echo "can't archive $b: it's checked out (switch away first)" >&2
            exit 1
        fi
        to_archive+=("$b")
        reasons+=("requested")
    done
    yes=1
else
    while read -r t b; do
        [ "$b" = "$current" ] && continue
        [ "$b" = main ] || [ "$b" = master ] || [ "$b" = "$main_branch" ] && continue
        grep -qxF -- "$b" <<<"$checked_out" && continue

        if [[ $b == tmp/* ]]; then
            to_delete+=("$b")
            continue
        fi

        why=()
        [[ $b == feat/* || $b == fix/* || $b == chore/* ]] || why+=("no feat/fix/chore prefix")
        [ "$t" -lt "$cutoff" ] && why+=("last used $(date -d "@$t" +%F)")
        if [ -n "$base" ] && [ -n "$me" ] && [ "$(my_unmerged "$b")" = 0 ]; then
            why+=("no unmerged commits of mine")
        fi
        [ ${#why[@]} -gt 0 ] || continue

        to_archive+=("$b")
        reasons+=("$(IFS=,; echo "${why[*]}" | sed 's/,/, /g')")
    done < <(git branch-activity)
fi

if [ ${#to_archive[@]} -eq 0 ] && [ ${#to_delete[@]} -eq 0 ]; then
    echo "Nothing to archive or delete."
    exit
fi

if [ ${#to_archive[@]} -gt 0 ]; then
    echo "Branches to archive:"
    for i in "${!to_archive[@]}"; do
        printf "  %s%s%s  ${DIM}(%s)${RESET}\n" "$BOLD" "${to_archive[$i]}" "$RESET" "${reasons[$i]}"
    done
fi
if [ ${#to_delete[@]} -gt 0 ]; then
    echo "Branches to delete:"
    for b in "${to_delete[@]}"; do
        printf "  %s%s%s  ${DIM}(tmp/ prefix)${RESET}\n" "$BOLD" "$b" "$RESET"
    done
fi

[ "$dry_run" = 1 ] && exit

if [ "$yes" = 0 ]; then
    read -r -p "Archive ${#to_archive[@]} and delete ${#to_delete[@]} branch(es)? [y/N] " answer
    [[ $answer == [yY]* ]] || { echo "Aborted."; exit 1; }
fi

deleted=0
for b in "${to_delete[@]}"; do
    sha=$(git rev-parse --short "refs/heads/$b")
    if git branch -q -D -- "$b"; then
        echo "deleted $b ${DIM}(was $sha)${RESET}"
        deleted=$((deleted + 1))
    else
        echo "failed to delete $b" >&2
    fi
done

for b in "${to_archive[@]}"; do
    sha=$(git rev-parse "refs/heads/$b")
    dest="$ARCHIVE/$b"
    # Don't clobber an older archived branch with the same name.
    if git show-ref -q --verify "$dest"; then
        dest="$dest-$(date +%Y%m%d-%H%M%S)"
    fi
    # Create the archive ref first, then remove the branch ref only if it
    # still points at the same commit, so nothing can be lost in between.
    git update-ref -m "cleanup: archive $b" "$dest" "$sha" ""
    git update-ref -d "refs/heads/$b" "$sha"
done

[ ${#to_delete[@]} -gt 0 ] && echo "Deleted $deleted tmp/ branch(es)."
[ ${#to_archive[@]} -gt 0 ] && echo "Archived ${#to_archive[@]} branch(es). See them with 'git cleanup list';" \
     "bring one back with 'git cleanup restore <branch>'."
exit 0
