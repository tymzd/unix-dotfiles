{
  /* ---------------------------------------------------------------------- */
  /*                          Appearance & Themes                           */
  /* ---------------------------------------------------------------------- */
  "workbench.colorTheme": "Default High Contrast",
  "workbench.preferredLightColorTheme": "Visual Studio 2019 Light",
  "workbench.preferredDarkColorTheme": "Cyberpunk",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorCustomizations": {
    "editor.lineHighlightBackground": "#1073cf10",
    "editor.lineHighlightBorder": "#9fced10f",
    "editorRuler.foreground": "#88888866",
    // [AI-generated by the Jetski coding agent, 2026-10-08]
    // Subtle panel/window borders with a crisp focus outline, in both dark
    // and light mode. Theme-scoped because the right colours depend on the
    // background; add new theme names to the matching block. (Multiple
    // matching blocks merge, so a theme can appear in more than one.)
    "[Default High Contrast][Cyberpunk]": {
      "contrastActiveBorder": "#ffffff",
      "contrastBorder": "#33464d",
      "focusBorder": "#ffffff"
    },
    "[Default High Contrast Light][Visual Studio 2019 Light]": {
      "contrastActiveBorder": "#000000",
      "contrastBorder": "#c3ced2",
      "focusBorder": "#000000"
    },
    // Dark High Contrast only: remaining keys whose default is orange
    // (#f38518). High Contrast Light doesn't use orange for these.
    "[Default High Contrast]": {
      "editor.lineHighlightBorder": "#33464d",
      "listFilterWidget.outline": "#33464d",
      "terminal.findMatchBorder": "#33464d",
      "terminal.findMatchHighlightBorder": "#33464d",
      "terminalOverviewRuler.findMatchForeground": "#33464d"
    }
  },

  /* ---------------------------------------------------------------------- */
  /*                           Window & Workbench                           */
  /* ---------------------------------------------------------------------- */
  "window.zoomLevel": 2,
  "window.titleBarStyle": "custom",
  "window.customTitleBarVisibility": "windowed",
  "window.menuBarVisibility": "compact",
  "window.commandCenter": false,
  "window.confirmSaveUntitledWorkspace": false,
  "workbench.startupEditor": "none",
  "workbench.activityBar.location": "hidden",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.layoutControl.enabled": false,
  "workbench.list.smoothScrolling": true,
  "workbench.list.openMode": "doubleClick",
  "workbench.tree.indent": 16,
  "workbench.editor.titleScrollbarSizing": "large",
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter.notebook.ipynb"
  },
  "zenMode.fullScreen": false,
  "zenMode.centerLayout": true,
  "zenMode.restore": true,
  "zenMode.hideLineNumbers": false,
  "breadcrumbs.enabled": true,
  "breadcrumbs.icons": false,
  "outline.icons": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,

  /* ---------------------------------------------------------------------- */
  /*                                 Editor                                 */
  /* ---------------------------------------------------------------------- */
  "editor.lineNumbers": "relative",
  "editor.smoothScrolling": true,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.wordWrap": "off",
  "diffEditor.wordWrap": "off",
  "editor.rulers": [80],
  "editor.guides.indentation": false,
  "editor.guides.bracketPairs": false,
  "editor.inlayHints.enabled": "on",
  "editor.autoClosingBrackets": "always",
  "editor.detectIndentation": false,
  "editor.trimAutoWhitespace": true,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.suggestSelection": "first",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.tabWidth": 4,

  /* ---------------------------------------------------------------------- */
  /*                                Terminal                                */
  /* ---------------------------------------------------------------------- */
  "terminal.integrated.tabs.enabled": false,
  "terminal.integrated.enableMultiLinePasteWarning": false,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.suggest.quickSuggestions": {
    "commands": "on",
    "arguments": "off",
    "unknown": "off"
  },

  /* ---------------------------------------------------------------------- */
  /*                              Vim & Input                               */
  /* ---------------------------------------------------------------------- */
  "keyboard.dispatch": "keyCode",
  "vim.foldfix": true,
  "vim.smartRelativeLine": true,
  "vim.gdefault": true,
  "vim.statusBarColorControl": false,
  // [AI-generated by the Jetski coding agent, 2026-10-08] (this block, down
  // to vim.sneak). NOTE: VSCodeVim is a UI extension, so over Remote-SSH it
  // reads the *client* (laptop) settings.json, not this workstation copy.
  // Changes here only reach the laptop via Settings Sync, which silently
  // stops syncing settings on a conflict. Edit the laptop copy to be sure.
  // Briefly flash the text that was just yanked.
  "vim.highlightedyank.enable": true,
  // <leader>w / <leader>b / <leader>e move by camelCase / snake_case word
  // parts (e.g. "fooBarBaz": w stops at Bar, Baz). Also works as a text
  // object: ci<leader>w changes just one part. Normal mode only in practice:
  // in visual mode, space is taken by the chords in keybindings.json.
  "vim.camelCaseMotion.enable": true,
  // Sneak: s{c}{c} / S{c}{c} jump forward/back to the next 2-char match
  // (across lines); ; and , repeat. With an operator use z/Z (dz{c}{c}).
  // Replaces built-in s (use cl instead). Plain f/t/F/T are unchanged.
  "vim.sneak": true,
  "vim.handleKeys": {
    "<C-c>": false,
    "<C-v>": false,
    "<C-x>": false,
    "<C-w>": false,
    "<C-f>": false,
    "<C-n>": false,
    "<C-t>": false,
    "<C-p>": false
  },
  // Use space as the Vim leader key. <leader>a (space+a) selects all
  // occurrences of the word under the cursor / visual selection with multiple
  // cursors (like 'gb', but for every match at once). Then 'c' to replace.
  // Case sensitivity: with a visual selection, matching follows the find
  // widget's "Match Case" toggle (ctrl+f, then alt+c / the 'Aa' button;
  // alt+w for whole word). With no selection (word under cursor), it's always
  // case-sensitive and whole-word.
  "vim.leader": "<space>",
  "vim.normalModeKeyBindingsNonRecursive": [
    { "before": ["<leader>", "a"], "commands": ["editor.action.selectHighlights"] }
  ],
  // [AI-generated by the Jetski coding agent, 2026-10-08]
  // Visual mode: <leader>a and <leader>A (cursor at end of every selected
  // line) are defined in keybindings.json as "space" chords, because
  // VSCodeVim remaps restore the visual selection and wipe new cursors. That
  // chord swallows space in visual mode, so the visual <leader>a entry below
  // is effectively dead; it's kept as a fallback if the chords are removed.
  // See the comment block in keybindings.json for the full list of quirks.
  "vim.visualModeKeyBindingsNonRecursive": [
    { "before": ["<leader>", "a"], "commands": ["editor.action.selectHighlights"] }
  ],
  // [AI-generated by the Jetski coding agent, 2026-10-08]
  // Visual-mode p/P paste over the selection WITHOUT overwriting the register
  // with the replaced text, so you can yank once and paste over many things.
  // Implemented via replaceWithRegister's gr (must be a *recursive* remap so
  // gr resolves to the plugin). Normal-mode p/P never touch the register, so
  // they're left alone. Earlier deleted text is still in "1-"9 if needed.
  // Side effect: gr{motion} / grr in normal mode also replace with register.
  "vim.replaceWithRegister": true,
  "vim.visualModeKeyBindings": [
    { "before": ["p"], "after": ["g", "r"] },
    { "before": ["P"], "after": ["g", "r"] }
  ],
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1,
    "asvetliakov.vscode-neovim": 1
  },

  /* ---------------------------------------------------------------------- */
  /*                           Files & Languages                            */
  /* ---------------------------------------------------------------------- */
  "files.exclude": {
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true
  },
  "files.associations": {
    "*.mdx": "markdown",
    "*.ddl": "sql"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true
  },
  "go.toolsManagement.autoUpdate": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.autopep8"
  },
  "python.analysis.typeCheckingMode": "basic",
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "C_Cpp.updateChannel": "Insiders",
  "C_Cpp.default.compilerPath": "/usr/bin/g++",
  "C_Cpp.default.compilerArgs": ["-std=c++2a"],
  "C_Cpp.copilotHover": "disabled",
  "cmake.configureOnOpen": false,
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
  },
  "[json]": {
    "editor.quickSuggestions": {
      "strings": true
    },
    "editor.suggest.insertMode": "replace",
    "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "mervin.markdown-formatter",
    "editor.formatOnSave": false
  },
  "[mdx]": {
    "editor.formatOnSave": false
  },
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [80],
    "editor.selectionHighlight": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off"
  },

  /* ---------------------------------------------------------------------- */
  /*                           Git & Integrations                           */
  /* ---------------------------------------------------------------------- */
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.terminalAuthentication": false,
"git.blame.editorDecoration.enabled": false,

  /* ---------------------------------------------------------------------- */
  /*                         Extensions & Misc                              */
  /* ---------------------------------------------------------------------- */
  "debug.toolBarLocation": "docked",
  "debug.showBreakpointsInOverviewRuler": true,
  "security.workspace.trust.untrustedFiles": "open",
  "update.mode": "none",
  "cSpell.enabled": false,
  "cSpell.language": "en-GB",
  "cSpell.enableFiletypes": [
    "!javascript",
    "!typescriptreact",
    "mdx"
  ],
  "ltex.language": "en-GB",
  "csharp.suppressDotnetInstallWarning": true,
  "redhat.telemetry.enabled": false,
  "prisma.showPrismaDataPlatformNotification": false,
  "hediet.vscode-drawio.resizeImages": null,
  "docker.extension.enableComposeLanguageServer": false,
  "geminicodeassist.recitation.maxCitedLength": 0,
  "chat.agent.enabled": false,
  "chat.notifyWindowOnConfirmation": "off",
"chat.commandCenter.enabled": false,
"workbench.browser.showInTitleBar": false,
"workbench.browser.searchEngine": "google"
}